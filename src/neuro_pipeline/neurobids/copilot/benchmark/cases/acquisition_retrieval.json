      "level1_tool": "find_acquisitions",
      "level1_arguments": {"datatype": "unknown"},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "find_acquisitions", "arguments": {"datatype": "unknown"}},
        {"type": "message", "content": "4 included acquisitions use the unknown/fallback mapping."}
      ]
