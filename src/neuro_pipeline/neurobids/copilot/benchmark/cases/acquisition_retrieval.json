{
  "version": 1,
  "category": "acquisition_retrieval",
  "cases": [
    {
      "id": "AR-01",
      "category": "acquisition_retrieval",
      "prompt": "Show all T1w acquisitions.",
      "expected_behavior": "read-only response",
      "expected_tools": ["find_acquisitions"],
      "expected_tool_arguments": {"sequence": "t1"},
      "expected_answer": {"n_matches": 4},
      "expected_acquisitions": [
        "uid.001.01.t1w",
        "uid.001.02.t1w",
        "uid.002.01.t1w",
        "uid.003.01.t1w"
      ],
      "expected_auto_apply": false,
      "levels": ["level1", "level2"],
      "level1_tool": "find_acquisitions",
      "level1_arguments": {"sequence": "t1"},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "find_acquisitions", "arguments": {"sequence": "t1"}},
        {"type": "message", "content": "There are 4 T1w acquisitions."}
      ]
    },
    {
