    {
      "id": "AR-05",
      "category": "acquisition_retrieval",
      "prompt": "Find acquisitions without a BIDS mapping.",
      "expected_behavior": "read-only response",
      "expected_tools": ["find_acquisitions"],
      "expected_tool_arguments": {"datatype": "unknown"},
      "expected_answer": {"n_matches": 4},
      "expected_acquisitions": [
