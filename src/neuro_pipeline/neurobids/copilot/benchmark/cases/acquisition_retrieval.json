        "uid.002.01.ambig",
        "uid.003.01.loc",
        "uid.003.01.unmap"
      ],
      "expected_auto_apply": false,
      "notes": "Included series with fallback datatype 'unknown'. The excluded Phoenix series has an empty datatype and is covered by AR-07.",
