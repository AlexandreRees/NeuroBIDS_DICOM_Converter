{
  "version": 1,
  "category": "dataset_understanding",
  "cases": [
    {
      "id": "LN-01",
      "category": "bids_reasoning",
      "tags": [
        "longitudinal"
      ],
      "prompt": "Compare session datatypes for longitudinal subject 001.",
      "expected_tools": [
        "inspect_subject"
      ],
      "expected_tool_arguments": {
        "subject_id": "001"
      },
      "expected_answer": {
        "derived.n_sessions": 2,
        "derived.session_datatypes.01": [
          "anat",
          "dwi",
          "func",
          "unknown"
        ],
        "derived.session_datatypes.02": [
          "anat",
          "func"
        ]
      },
      "expected_session_datatypes": {
        "01": [
          "anat",
          "func",
          "dwi"
        ],
        "02": [
          "anat",
          "func"
        ]
      },
      "expected_answer_contains": [
        "DWI"
      ],
      "level1_tool": "inspect_subject",
      "level1_arguments": {
        "subject_id": "001"
      },
      "scripted_llm_responses": [
        {
          "type": "tool_call",
          "tool_name": "inspect_subject",
          "arguments": {
            "subject_id": "001"
          }
        },
        {
          "type": "message",
          "content": "Subject 001 is longitudinal. Session 01 includes DWI; session 02 does not."
        }
      ],
      "expected_behavior": "read-only response",
      "expected_auto_apply": false,
      "levels": [
        "level1",
        "level2"
      ]
    },
    {
      "id": "LN-02",
