      "expected_auto_apply": false,
      "expected_final_plan": {"subjects": ["004", "10", "20", "30"]},
      "apply_changeset": true,
      "levels": ["level1", "level2"],
      "level1_tool": "rename_subjects",
      "level1_arguments": {
        "mode": "mapping",
        "mapping": {"001": "10", "002": "20", "003": "30"}
      },
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "rename_subjects", "arguments": {"mode": "mapping", "mapping": {"001": "10", "002": "20", "003": "30"}}}
      ]
    },
    {
      "id": "MU-03",
      "category": "mutations",
      "prompt": "Rename sessions of subject 001 from 01/02 to pre/post.",
      "expected_behavior": "mutation proposal",
      "expected_tools": ["rename_sessions"],
      "expected_tool_arguments": {
        "mode": "mapping",
        "subject_id": "001",
        "mapping": {"01": "pre", "02": "post"}
