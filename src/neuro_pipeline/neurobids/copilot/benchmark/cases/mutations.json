    {
      "id": "MU-05",
      "category": "mutations",
      "prompt": "Exclude localizers from conversion.",
      "expected_behavior": "mutation proposal",
      "expected_tools": ["exclude_acquisitions"],
      "expected_tool_arguments": {"series_uids": ["uid.001.01.loc", "uid.003.01.loc"]},
      "expected_change_set": {
        "tool_name": "exclude_acquisitions",
        "status_not": "APPLIED",
        "include_changes": [
          {"series_uid": "uid.001.01.loc", "after": false},
          {"series_uid": "uid.003.01.loc", "after": false}
        ]
      },
      "expected_auto_apply": false,
      "expected_final_plan": {
        "include": {"uid.001.01.loc": false, "uid.003.01.loc": false, "uid.001.01.t1w": true}
      },
      "apply_changeset": true,
      "gui_action": "apply",
      "levels": ["level1", "level2", "level3"],
      "level1_tool": "exclude_acquisitions",
      "level1_arguments": {"series_uids": ["uid.001.01.loc", "uid.003.01.loc"], "reason": "exclude localizers"},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "exclude_acquisitions", "arguments": {"series_uids": ["uid.001.01.loc", "uid.003.01.loc"], "reason": "exclude localizers"}}
      ]
    },
