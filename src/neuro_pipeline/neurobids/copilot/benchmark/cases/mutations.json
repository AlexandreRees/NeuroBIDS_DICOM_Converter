      "expected_auto_apply": false,
      "expected_final_plan": {
        "fields": {
          "uid.001.01.t1w": {"session": "pre"},
          "uid.001.02.t1w": {"session": "post"},
          "uid.002.01.t1w": {"session": "01"}
        }
      },
      "apply_changeset": true,
      "levels": ["level1", "level2"],
      "level1_tool": "rename_sessions",
      "level1_arguments": {
        "mode": "mapping",
        "subject_id": "001",
        "mapping": {"01": "pre", "02": "post"}
      },
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "rename_sessions", "arguments": {"mode": "mapping", "subject_id": "001", "mapping": {"01": "pre", "02": "post"}}}
      ]
    },
