{
  "version": 1,
  "category": "mutations",
  "cases": [
    {
      "id": "MU-01",
      "category": "mutations",
      "prompt": "Rename subjects sequentially starting at 010.",
      "expected_behavior": "mutation proposal",
      "expected_tools": ["rename_subjects"],
      "expected_tool_arguments": {"mode": "sequential", "start": 10, "width": 3},
      "expected_change_set": {
        "tool_name": "rename_subjects",
        "status_not": "APPLIED",
        "subject_renames": {"001": "010", "002": "011", "003": "012", "004": "013"}
      },
      "expected_auto_apply": false,
      "expected_final_plan": {"subjects": ["010", "011", "012", "013"]},
      "apply_changeset": true,
      "gui_action": "apply",
      "levels": ["level1", "level2", "level3"],
      "level1_tool": "rename_subjects",
      "level1_arguments": {"mode": "sequential", "start": 10, "width": 3, "reason": "sequential rename"},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "rename_subjects", "arguments": {"mode": "sequential", "start": 10, "width": 3, "preserve_sessions": true}}
      ]
    },
    {
      "id": "MU-02",
      "category": "mutations",
