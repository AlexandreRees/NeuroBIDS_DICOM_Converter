      "expected_tool_arguments": {
        "series_uid": "uid.003.01.unmap"
      },
      "expected_answer": {
        "derived.ambiguous": true,
        "derived.proposed.datatype": "unknown"
      },
      "level1_tool": "propose_bids_mapping",
      "level1_arguments": {
        "series_uid": "uid.003.01.unmap"
      },
      "scripted_llm_responses": [
        {
          "type": "tool_call",
          "tool_name": "audit_dataset",
          "arguments": {
            "code": "unmapped"
          }
        },
        {
          "type": "tool_call",
          "tool_name": "propose_bids_mapping",
          "arguments": {
            "series_uid": "uid.003.01.unmap"
          }
        },
        {
          "type": "message",
          "content": "No confident BIDS mapping exists; the series is flagged for manual review."
        }
      ],
      "expected_behavior": "read-only response",
      "expected_auto_apply": false,
      "levels": [
        "level1",
        "level2"
      ]
    },
