{
  "version": 1,
  "category": "dataset_understanding",
  "cases": [
    {
      "id": "MS-01",
      "category": "dataset_understanding",
      "tags": [
        "multi_step"
      ],
      "prompt": "First inspect the dataset, then list every subject ID.",
      "expected_tools": [
        "inspect_dataset",
        "list_subjects"
      ],
      "expected_tool_arguments": {},
      "expected_answer": {
        "n_subjects": 4,
        "derived.subject_ids": [
          "001",
          "002",
          "003",
          "004"
        ]
      },
      "expected_subjects": [
        "001",
        "002",
        "003",
        "004"
      ],
      "level1_tool": "list_subjects",
      "level1_arguments": {},
      "scripted_llm_responses": [
        {
          "type": "tool_call",
          "tool_name": "inspect_dataset",
          "arguments": {}
        },
        {
          "type": "tool_call",
          "tool_name": "list_subjects",
          "arguments": {}
        },
        {
          "type": "message",
          "content": "The subject IDs are 001, 002, 003, and 004."
        }
      ],
      "expected_behavior": "read-only response",
      "expected_auto_apply": false,
      "levels": [
        "level1",
        "level2"
      ]
    },
    {
      "id": "MS-02",
      "category": "dataset_understanding",
      "tags": [
        "multi_step",
        "longitudinal"
      ],
      "prompt": "Inspect subject 001, then list only session 02 acquisitions.",
      "expected_tools": [
        "inspect_subject",
        "find_acquisitions"
      ],
      "expected_tool_arguments": {
        "subject": "001",
        "session": "02"
      },
      "expected_answer": {
        "n_matches": 2
      },
      "expected_acquisitions": [
        "uid.001.02.t1w",
        "uid.001.02.func"
      ],
      "level1_tool": "find_acquisitions",
      "level1_arguments": {
        "subject": "001",
        "session": "02"
      },
      "scripted_llm_responses": [
        {
          "type": "tool_call",
          "tool_name": "inspect_subject",
          "arguments": {
            "subject_id": "001"
          }
        },
        {
          "type": "tool_call",
          "tool_name": "find_acquisitions",
          "arguments": {
            "subject": "001",
            "session": "02"
          }
        },
        {
          "type": "message",
          "content": "Session 02 has 2 acquisitions (subject 001 only)."
        }
      ],
      "expected_behavior": "read-only response",
      "expected_auto_apply": false,
      "levels": [
        "level1",
        "level2"
      ]
    },
    {
      "id": "MS-03",
      "category": "mutations",
      "tags": [
        "multi_step"
      ],
      "prompt": "Find localizer series, then exclude them from conversion.",
      "expected_tools": [
        "find_acquisitions",
        "exclude_acquisitions"
      ],
      "expected_tool_arguments": {
        "series_uids": [
          "uid.001.01.loc",
          "uid.003.01.loc"
        ]
      },
      "expected_change_set": {
        "tool_name": "exclude_acquisitions",
        "status_not": "APPLIED",
        "include_changes": [
          {
            "series_uid": "uid.001.01.loc",
            "after": false
          },
          {
            "series_uid": "uid.003.01.loc",
            "after": false
          }
        ]
      },
      "apply_changeset": false,
      "level1_tool": "exclude_acquisitions",
      "level1_arguments": {
        "series_uids": [
          "uid.001.01.loc",
          "uid.003.01.loc"
        ]
      },
      "scripted_llm_responses": [
        {
          "type": "tool_call",
          "tool_name": "find_acquisitions",
          "arguments": {
            "sequence": "localizer"
          }
        },
        {
          "type": "tool_call",
          "tool_name": "exclude_acquisitions",
          "arguments": {
            "series_uids": [
              "uid.001.01.loc",
              "uid.003.01.loc"
            ]
          }
        }
      ],
      "expected_behavior": "mutation proposal",
      "expected_auto_apply": false,
      "levels": [
        "level1",
        "level2"
      ]
    },
    {
      "id": "MS-04",
      "category": "bids_reasoning",
      "tags": [
        "multi_step",
        "missing_metadata"
      ],
      "prompt": "Audit unmapped series, then propose a mapping for unknown_protocol.",
      "expected_tools": [
        "audit_dataset",
