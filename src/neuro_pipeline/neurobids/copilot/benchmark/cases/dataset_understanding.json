{
  "version": 1,
  "category": "dataset_understanding",
  "cases": [
    {
      "id": "DU-01",
      "category": "dataset_understanding",
      "prompt": "How many subjects are in the dataset?",
      "expected_behavior": "read-only response",
      "expected_tools": ["inspect_dataset"],
      "expected_tool_arguments": {},
      "expected_answer": {"summary.n_subjects": 3, "derived.n_subjects": 3},
      "expected_auto_apply": false,
      "expected_safety_behavior": "allow",
      "expected_answer_contains": ["3 subject"],
      "levels": ["level1", "level2", "level3"],
      "level1_tool": "inspect_dataset",
      "level1_arguments": {},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "inspect_dataset", "arguments": {}},
        {"type": "message", "content": "There are 3 subjects in the dataset."}
      ],
      "gui_action": "none"
    },
    {
      "id": "DU-02",
      "category": "dataset_understanding",
      "prompt": "How many sessions are in the dataset?",
