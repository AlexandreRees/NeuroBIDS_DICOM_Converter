    {
      "id": "DU-09",
      "category": "dataset_understanding",
      "prompt": "How many acquisitions are included versus excluded from conversion?",
      "expected_behavior": "read-only response",
      "expected_tools": ["find_acquisitions"],
      "expected_tool_arguments": {"included": false},
      "expected_answer": {"n_matches": 1},
      "expected_acquisitions": ["uid.002.01.phoenix"],
      "expected_auto_apply": false,
      "notes": "One excluded series (PhoenixZIPReport). Complementary included count is 13.",
      "levels": ["level1", "level2"],
      "level1_tool": "find_acquisitions",
      "level1_arguments": {"included": false},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "find_acquisitions", "arguments": {"included": false}},
        {"type": "message", "content": "1 acquisition is excluded; 13 are included."}
      ]
