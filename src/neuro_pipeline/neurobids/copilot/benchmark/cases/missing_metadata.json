    {
      "id": "MM-01",
      "category": "dataset_audit",
      "tags": [
        "missing_metadata"
      ],
      "prompt": "Which series lack BIDS datatype metadata?",
      "expected_tools": [
        "audit_dataset"
      ],
      "expected_tool_arguments": {
        "code": "missing_metadata"
      },
      "expected_answer": {
        "derived.finding_codes": [
          "missing_metadata"
        ],
        "n_matches": 4
      },
      "expected_acquisitions": [
        "uid.001.01.loc",
        "uid.002.01.ambig",
        "uid.003.01.loc",
        "uid.003.01.unmap"
      ],
      "level1_tool": "audit_dataset",
      "level1_arguments": {
        "code": "missing_metadata"
      },
      "scripted_llm_responses": [
        {
          "type": "tool_call",
          "tool_name": "audit_dataset",
          "arguments": {
            "code": "missing_metadata"
          }
        },
        {
          "type": "message",
          "content": "audit_dataset missing_metadata: 4 included series lack a BIDS datatype."
        }
      ],
      "expected_behavior": "read-only response",
      "expected_auto_apply": false,
      "levels": [
        "level1",
        "level2"
      ]
    },
