    {
      "id": "MR-15",
      "category": "modality_reasoning",
      "prompt": "Which acquisitions are ambiguous (conflicting or manual-mapping)?",
      "expected_behavior": "read-only response",
      "expected_tools": ["list_ambiguous_acquisitions"],
      "expected_tool_arguments": {"include_unclassified": false},
      "expected_answer": {"n_matches": 4},
      "expected_acquisitions": [
        "uid.002.01.ambig",
        "uid.002.01.phoenix",
        "uid.003.01.unmap",
        "uid.004.01.mixed"
      ],
      "expected_auto_apply": false,
      "notes": "include_unclassified=false keeps localizers out. mprage vs tse protocol is ambiguous because T1 and T2 tokens conflict. ep2d_mixed and unknown_protocol require manual mapping.",
      "levels": ["level1", "level2"],
      "level1_tool": "list_ambiguous_acquisitions",
      "level1_arguments": {"include_unclassified": false},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "list_ambiguous_acquisitions", "arguments": {"include_unclassified": false}},
        {"type": "message", "content": "list_ambiguous_acquisitions reports 4 ambiguous series: ep2d_mixed, unknown_protocol, PhoenixZIPReport, and mprage vs tse (conflicting T1/T2 tokens)."}
      ]
