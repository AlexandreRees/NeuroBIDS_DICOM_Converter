{
  "version": 1,
  "category": "modality_reasoning",
  "cases": [
    {
      "id": "MR-01",
      "category": "modality_reasoning",
      "prompt": "Classify the T1w acquisition of subject 001 session 01.",
      "expected_behavior": "read-only response",
      "expected_tools": ["classify_acquisition"],
      "expected_tool_arguments": {"series_uid": "uid.001.01.t1w"},
      "expected_answer": {
        "derived.label": "T1w",
        "derived.datatype": "anat",
        "derived.suffix": "T1w",
        "derived.ambiguous": false
      },
      "expected_acquisitions": ["uid.001.01.t1w"],
      "expected_auto_apply": false,
      "expected_answer_contains": ["T1w"],
      "levels": ["level1", "level2"],
      "level1_tool": "classify_acquisition",
      "level1_arguments": {"series_uid": "uid.001.01.t1w"},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "classify_acquisition", "arguments": {"series_uid": "uid.001.01.t1w"}},
        {"type": "message", "content": "classify_acquisition reports label T1w, datatype anat, suffix T1w. Evidence includes series_description=t1_mprage. It is not ambiguous."}
      ]
    },
    {
