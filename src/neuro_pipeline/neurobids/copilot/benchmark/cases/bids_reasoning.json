      "levels": ["level1", "level2"],
      "level1_tool": "propose_bids_mapping",
      "level1_arguments": {"series_uid": "uid.001.01.loc"},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "propose_bids_mapping", "arguments": {"series_uid": "uid.001.01.loc"}},
        {"type": "message", "content": "The localizer has sequence_type unknown and only a fallback NIfTI name; it should be reviewed before conversion."}
      ]
    },
    {
      "id": "BR-09",
      "category": "bids_reasoning",
      "prompt": "Propose a BIDS mapping for the unmapped unknown_protocol series.",
      "expected_behavior": "read-only response",
      "expected_tools": ["propose_bids_mapping"],
      "expected_tool_arguments": {"series_uid": "uid.003.01.unmap"},
      "expected_answer": {"derived.ambiguous": true, "derived.proposed.datatype": "unknown"},
      "expected_auto_apply": false,
      "levels": ["level1", "level2"],
      "level1_tool": "propose_bids_mapping",
      "level1_arguments": {"series_uid": "uid.003.01.unmap"},
      "scripted_llm_responses": [
        {"type": "tool_call", "tool_name": "propose_bids_mapping", "arguments": {"series_uid": "uid.003.01.unmap"}},
        {"type": "message", "content": "No confident BIDS mapping exists; the series is flagged for manual review."}
      ]
    },
    {
      "id": "BR-10",
