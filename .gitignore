pizarro_transfer_learning/
figures/

# ----- Backups / archives -----
archive_old_bids_backups/
release_dataset_backup*/
bids_backup*/
bids_metadata_backup*/
defacing_metadata_backup/

# ----- Runtime / caches / environments -----
logs/
work/
.nextflow/
